{
  "name": "playwright-ts-automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "test:smoke": "playwright test --grep @smoke",
    "test:desktop": "playwright test --project=chromium --project=firefox --project=edge",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-edge",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:edge": "playwright test --project=edge",
    "allure:generate": "allure generate allure-results",
    "allure:open": "allure open allure-report",
    "allure": "allure generate allure-results --open",
    "allure:clean": "node -e \"for (const d of ['allure-results','allure-report']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "test:monsters": "playwright test tests/monsters",
    "test:monsters:live": "cross-env MONSTERS_ENV=live playwright test tests/monsters",
    "test:monsters:submit": "cross-env MONSTERS_ENV=live SUBMIT_REAL_FORM=1 playwright test real-submit --project=chromium",
    "report:full": "node tools/report-full.mjs",
    "test:a11y": "playwright test --grep @a11y",
    "test:testiny": "cross-env TESTINY_UPLOAD=1 MONSTERS_ENV=live playwright test",
    "export:testiny": "node tools/export-testiny-csv.mjs",
    "perf:smoke": "cross-env K6_WEB_DASHBOARD=true K6_WEB_DASHBOARD_OPEN=false K6_WEB_DASHBOARD_EXPORT=reports/k6-smoke-report.html k6 run perf/smoke.ts",
    "perf:load": "cross-env K6_WEB_DASHBOARD=true K6_WEB_DASHBOARD_OPEN=false K6_WEB_DASHBOARD_EXPORT=reports/k6-load-report.html k6 run perf/load.ts",
    "perf:soak": "cross-env \"K6_BROWSER_ARGS=host-resolver-rules=MAP fonts.g* ~NOTFOUND\" K6_WEB_DASHBOARD=true K6_WEB_DASHBOARD_OPEN=false K6_WEB_DASHBOARD_EXPORT=reports/k6-soak-report.html k6 run perf/soak.ts",
    "tests": "node tools/run-tests.mjs",
    "test:ui-only": "playwright test --grep-invert @a11y",
    "report:pdf": "node tools/report-pdf.mjs",
    "test:monsters:dev": "cross-env MONSTERS_ENV=dev playwright test tests/monsters",
    "test:monsters:local": "cross-env MONSTERS_ENV=local playwright test tests/monsters",
    "test:live": "node tools/run-tests.mjs --env=live",
    "test:preview": "node tools/run-tests.mjs --preview",
    "test:dev": "node tools/run-tests.mjs --env=dev",
    "manual:build": "node tools/build-manual-tests.mjs",
    "test:browserstack": "node tools/run-tests.mjs --env=live --suite=ui --browsers=browserstack",
    "test:desktop-ui": "node tools/run-tests.mjs --env=live --suite=ui --browsers=desktop",
    "allure:browsers": "allure open allure-report/by-browser",
    "typecheck": "tsc -p . && tsc -p perf",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@testiny/automation": "^1.42.0",
    "@types/k6": "^2.3.0",
    "@types/node": "^26.6.5",
    "allure": "^3.20.1",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
