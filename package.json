{
  "name": "playwright-ts-automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "test:smoke": "playwright test --grep @smoke",
    "test:desktop": "playwright test --project=chromium --project=firefox --project=edge",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-edge",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:edge": "playwright test --project=edge",
    "allure:generate": "allure generate allure-results",
    "allure:open": "allure open allure-report",
    "allure": "allure generate allure-results --open",
    "allure:clean": "node -e \"for (const d of ['allure-results','allure-report']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "test:saucedemo": "playwright test tests/saucedemo",
    "test:monsters": "playwright test tests/monsters",
    "test:monsters:live": "cross-env MONSTERS_URL=https://substandard-monsters.netlify.app playwright test tests/monsters",
    "test:monsters:submit": "cross-env MONSTERS_URL=https://substandard-monsters.netlify.app SUBMIT_REAL_FORM=1 playwright test real-submit --project=chromium",
    "report:full": "node tools/report-full.mjs",
    "test:a11y": "playwright test --grep @a11y"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure": "^3.20.1",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "cross-env": "^10.1.0"
  }
}
