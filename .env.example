# Copy this file to .env (git-ignored) and fill in the values. Never commit .env.

# --- Testiny (npm run test:testiny) ---
# API key: Testiny > Settings > API keys
TESTINY_API_KEY=
# Project name, key or ID in Testiny
TESTINY_PROJECT=
# Optional: name of the automation source the results are filed under
# TESTINY_SOURCE=playwright-ui

# --- Sites under test (optional) ---
# Which Substandard Monsters copy plain `npx playwright test` uses: live | dev | local (default local).
# npm run tests asks instead.
# MONSTERS_ENV=local
# Addresses of each environment (defaults shown):
# MONSTERS_LIVE_URL=https://substandard-monsters.netlify.app
# MONSTERS_DEV_URL=https://dev--substandard-monsters.netlify.app
# MONSTERS_LOCAL_URL=http://localhost:4173
# Any other address, overrides MONSTERS_ENV:
# MONSTERS_URL=https://deploy-preview-12--substandard-monsters.netlify.app
# BASE_URL=https://www.saucedemo.com
