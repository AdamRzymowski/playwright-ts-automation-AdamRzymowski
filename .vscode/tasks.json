{
  // Terminal > Run Task... (or Ctrl+Shift+P > "Tasks: Run Task") to start a test run.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tests: choose what to run",
      "detail": "Asks: UI, accessibility, performance or all, then runs them",
      "type": "shell",
      "command": "npm run tests",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Tests: live site",
      "detail": "Asks which suites, then runs them against the published site",
      "type": "shell",
      "command": "npm run test:live",
      "group": "test",
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Tests: pull request preview",
      "detail": "Asks for the pull request number, then which suites",
      "type": "shell",
      "command": "npm run test:preview -- ${input:prNumber}",
      "group": "test",
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Tests: UI on desktop browsers (live)",
      "detail": "Chrome, Firefox and Edge against the published site",
      "type": "shell",
      "command": "npm run test:desktop-ui",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Tests: UI on desktop browsers, visible (live)",
      "detail": "Chrome, Firefox and Edge with the browser window shown, one test at a time",
      "type": "shell",
      "command": "npm run tests -- --env=live --suite=ui --browsers=desktop --headed",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Tests: UI on BrowserStack Mac (live)",
      "detail": "Safari and Chrome on macOS in BrowserStack's cloud; needs keys in .env",
      "type": "shell",
      "command": "npm run test:browserstack",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Tests: UI only",
      "type": "shell",
      "command": "npm run tests -- --suite=ui",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Tests: accessibility only",
      "type": "shell",
      "command": "npm run tests -- --suite=a11y",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Tests: performance smoke (k6)",
      "type": "shell",
      "command": "npm run tests -- --suite=perf --perf=smoke",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Tests: performance load (k6)",
      "type": "shell",
      "command": "npm run tests -- --suite=perf --perf=load",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Tests: all suites",
      "type": "shell",
      "command": "npm run tests -- --suite=all --perf=smoke",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Report: open Allure report",
      "type": "shell",
      "command": "npm run allure:open",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "prNumber",
      "type": "promptString",
      "description": "Pull request number (Netlify deploy preview), e.g. 12"
    }
  ]
}
